# dependencies
node_modules/

# build output
# 部署在 Cloudflare Pages（连 Git、自己跑 npm run build），所以产物不需要进仓库：
#   docs/  客户端产物 + 预渲染后的 index.html（Build output directory 填这个）
#   dist/  预渲染用的 SSR bundle 等构建中间物
# 需要看构建结果时本地跑 npm run build / npm run preview。
docs/
dist/

# logs
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# editor / os
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# local env
.env
.env.local
.env.*.local
